generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mysql"
    url = env("MYSQL_CONECTION_URL")
}

model Cliente {
    id Int @id @default(autoincrement())
    nome String
    telefone String?
    endereco String?
    ativo    Boolean @default (true)

    @@map("pw2_api_clientes")
}